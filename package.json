{
  "name": "kuronami",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env runtime/index.ts",
    "dev:ui": "tsx watch --env-file=.env ui/dev.ts",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm dev:ui\"",
    "run:task": "tsx --env-file=.env runtime/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:ui": "tsx ui/build.ts",
    "test": "vitest run",
    "test:ui": "vitest run ui/",
    "test:watch": "vitest watch ui/",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "migrate": "tsx --env-file=.env runtime/db/migrate.ts",
    "devui": "tsx --env-file=.env runtime/devui/server.ts",
    "gateway": "tsx --env-file=.env gateway/index.ts",
    "heartbeat": "tsx --env-file=.env heartbeat/index.ts",
    "say": "tsx --env-file=.env gateway/cli.ts",
    "agents:seed": "tsx --env-file=.env runtime/agents/seed.ts",
    "evals": "tsx --env-file=.env evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "@anthropic-ai/sdk": "^0.124.0",
    "express": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  }
}
