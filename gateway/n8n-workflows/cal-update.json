    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e = $input.first().json || {};\nconst isOutlook = typeof e.webLink === 'string';\nreturn [{ json: {\n  event_id: String(e.id || ''),\n  html_link: e.htmlLink || e.webLink || '',\n  calendar: isOutlook\n    ? ((e.organizer && e.organizer.emailAddress && e.organizer.emailAddress.address) || '')\n    : ((e.organizer && e.organizer.email) || 'primary'),\n  updated: !!e.id\n} }];"
      },
