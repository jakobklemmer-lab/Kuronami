    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Eingabe der Runtime: { event_id, title?, start?, end?, location?, description?, calendar? }\n// event_id traegt seit cal-list.json ein Konto-Praefix (z.B. 'outlook_1:AAMk...').\nconst incoming = $input.first().json;\nconst inp = incoming.body && typeof incoming.body === 'object' ? incoming.body : incoming;\nif (typeof inp.event_id !== 'string' || inp.event_id.trim() === '') {\n  throw new Error('cal-update: Feld \"event_id\" fehlt');\n}\nconst knownAccounts = ['gmail_1', 'gmail_2', 'gmail_3', 'outlook_1', 'outlook_2'];\nconst raw = inp.event_id.trim();\nconst sepIndex = raw.indexOf(':');\nconst prefix = sepIndex >= 0 ? raw.slice(0, sepIndex) : '';\nconst account = knownAccounts.includes(prefix) ? prefix : 'gmail_1';\nconst eventId = knownAccounts.includes(prefix) ? raw.slice(sepIndex + 1) : raw;\nconst update = {};\nif (typeof inp.title === 'string' && inp.title) update.summary = inp.title;\nif (typeof inp.start === 'string' && inp.start) update.start = inp.start;\nif (typeof inp.end === 'string' && inp.end) update.end = inp.end;\nif (typeof inp.location === 'string' && inp.location) update.location = inp.location;\nif (typeof inp.description === 'string' && inp.description) update.description = inp.description;\nif (Object.keys(update).length === 0) {\n  throw new Error('cal-update: kein zu aenderndes Feld angegeben');\n}\nconst updateForOutlook = {};\nif (typeof inp.title === 'string' && inp.title) updateForOutlook.subject = inp.title;\nif (typeof inp.start === 'string' && inp.start) updateForOutlook.start = inp.start;\nif (typeof inp.end === 'string' && inp.end) updateForOutlook.end = inp.end;\nif (typeof inp.location === 'string' && inp.location) updateForOutlook.location = inp.location;\nif (typeof inp.description === 'string' && inp.description) updateForOutlook.body = inp.description;\nreturn [{ json: {\n  eventId,\n  calendar: typeof inp.calendar === 'string' && inp.calendar ? inp.calendar : 'primary',\n  update,\n  updateForOutlook,\n  account\n} }];"
      },
