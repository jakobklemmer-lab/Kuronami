{
  "id": "kuronamiCalList01",
  "name": "cal.list",
  "meta": {
    "description": "Kuronami S15 + Nachtrag 2026-09-16 (Mehrkonten): Termine in einem Zeitbereich lesen. Eingabe { start, end, calendar?, limit? } (ISO 8601). Fragt alle fuenf konfigurierten Konten (drei Google-Kalender, zwei Outlook-Kalender) parallel ab und fuehrt die Termine zusammen; die id jedes Termins traegt ein Konto-Praefix, das cal-update.json beim Aendern auswertet. Der `calendar`-Parameter wirkt nur auf die Google-Zweige (providerübergreifend nicht abbildbar)."
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cal-list",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "cl0001-0000-4a00-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "cl0001-0000-4a00-8000-000000000001"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Eingabe der Runtime: { start, end, calendar?, limit? }\nconst incoming = $input.first().json;\nconst inp = incoming.body && typeof incoming.body === 'object' ? incoming.body : incoming;\nif (typeof inp.start !== 'string' || typeof inp.end !== 'string') {\n  throw new Error('cal-list: Felder \"start\" und \"end\" (ISO 8601) sind erforderlich');\n}\nreturn [{ json: {\n  timeMin: inp.start,\n  timeMax: inp.end,\n  calendar: typeof inp.calendar === 'string' && inp.calendar ? inp.calendar : 'primary',\n  limit: Number.isFinite(Number(inp.limit)) ? Number(inp.limit) : 100\n} }];"
      },
      "id": "cl0002-0000-4a00-8000-000000000002",
      "name": "Read range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": "={{ $json.calendar }}",
        "returnAll": false,
        "limit": "={{ $json.limit }}",
        "options": {
          "timeMin": "={{ $json.timeMin }}",
          "timeMax": "={{ $json.timeMax }}",
          "singleEvents": true,
          "orderBy": "startTime"
        }
      },
      "id": "cl0100-0000-4a00-8000-000000000100",
      "name": "Gmail 1: getAll",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [680, 60],
      "notes": "Google-Kalender des Kontos Gmail 1 — eigene Google-Calendar-Zugangsdaten in diesem Knoten hinterlegen (getrennt von der Gmail-Zugangsdaten desselben Kontos). Nur LESEN.",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item) => ({ json: { ...item.json, _account: 'gmail_1' } }));"
