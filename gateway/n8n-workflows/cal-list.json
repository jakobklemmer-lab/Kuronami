      "id": "cl0300-0000-4a00-8000-000000000300",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [1120, 340],
      "notes": "Haengt die Terminlisten aller Konten aneinander."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Alle Termine in die von der Runtime erwartete Form bringen. Die id traegt die\n// Konto-Kennung als Praefix (cal-update.json wertet sie aus).\nconst events = $input.all().map((item) => {\n  const e = item.json || {};\n  const account = e._account || 'gmail_1';\n  const isOutlook = account.startsWith('outlook');\n  if (isOutlook) {\n    const org = (e.organizer && e.organizer.emailAddress && e.organizer.emailAddress.address) || '';\n    return {\n      id: account + ':' + String(e.id || ''),\n      title: e.subject || '(kein Titel)',\n      start: (e.start && e.start.dateTime) || '',\n      end: (e.end && e.end.dateTime) || '',\n      all_day: e.isAllDay === true,\n      location: (e.location && e.location.displayName) || '',\n      calendar: org,\n      status: '',\n      description: e.bodyPreview || '',\n      account\n    };\n  }\n  const start = (e.start && (e.start.dateTime || e.start.date)) || e.start || '';\n  const end = (e.end && (e.end.dateTime || e.end.date)) || e.end || '';\n  return {\n    id: account + ':' + String(e.id || ''),\n    title: e.summary || '(kein Titel)',\n    start,\n    end,\n    all_day: !!(e.start && e.start.date && !e.start.dateTime),\n    location: e.location || '',\n    calendar: (e.organizer && e.organizer.email) || e.calendarId || '',\n    status: e.status || '',\n    description: e.description || '',\n    account\n  };\n});\nreturn [{ json: { events } }];"
      },
