    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Google liefert htmlLink, Outlook webLink — daran unterscheiden wir die Antwortform,\n// ohne die Konto-Kennung extra durchreichen zu muessen (nur ein Zweig feuert je Aufruf).\nconst e = $input.first().json || {};\nconst isOutlook = typeof e.webLink === 'string';\nreturn [{ json: {\n  event_id: String(e.id || ''),\n  html_link: e.htmlLink || e.webLink || '',\n  calendar: isOutlook\n    ? ((e.organizer && e.organizer.emailAddress && e.organizer.emailAddress.address) || '')\n    : ((e.organizer && e.organizer.email) || 'primary'),\n  created: !!e.id\n} }];"
      },
