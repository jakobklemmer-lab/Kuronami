    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Eingabe der Runtime: { title, start, end, location?, description?, calendar?, attendees?, account? }\nconst incoming = $input.first().json;\nconst inp = incoming.body && typeof incoming.body === 'object' ? incoming.body : incoming;\nfor (const field of ['title', 'start', 'end']) {\n  if (typeof inp[field] !== 'string' || inp[field].trim() === '') {\n    throw new Error('cal-create: Feld \"' + field + '\" fehlt');\n  }\n}\nconst attendees = typeof inp.attendees === 'string' && inp.attendees\n  ? inp.attendees.split(',').map((a) => a.trim()).filter(Boolean)\n  : [];\nconst knownAccounts = ['gmail_1', 'gmail_2', 'gmail_3', 'outlook_1', 'outlook_2'];\nconst account = knownAccounts.includes(inp.account) ? inp.account : 'gmail_1';\nreturn [{ json: {\n  calendar: typeof inp.calendar === 'string' && inp.calendar ? inp.calendar : 'primary',\n  summary: inp.title,\n  start: inp.start,\n  end: inp.end,\n  location: inp.location || '',\n  description: inp.description || '',\n  attendees,\n  attendeesForOutlook: attendees.map((email) => ({ email })),\n  account\n} }];"
      },
