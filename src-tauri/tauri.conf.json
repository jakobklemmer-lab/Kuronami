{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "kuronami-devui",
  "version": "0.1.0",
  "identifier": "com.kuronami.devui",
  "build": {
    "frontendDist": "http://localhost:8787"
  },
  "app": {
    "windows": [
      {
        "title": "Kuronami DevUI",
        "url": "http://localhost:8787",
        "width": 1120,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
