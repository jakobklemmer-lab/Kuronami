DATABASE_URL=postgres://kuronami:kuronami@localhost:5432/kuronami
ARTIFACT_ROOT=./artifacts
ANTHROPIC_API_KEY=
# Modell des Orchestrators (S12). Leer = claude-opus-5. Innerhalb einer Session nie wechseln
# (Abschnitt 7) — für ein anderes Modell eine neue Session oder einen Subagenten.
ANTHROPIC_MODEL=
LOG_LEVEL=info
# Absoluter Pfad zum lokalen Obsidian-Vault. Gesetzt = die notes.*-Tools (notes.read,
# notes.write, S15) kommen in den Katalog; sie greifen direkt aufs Dateisystem zu, ohne n8n.
# notes.write ist hartes Schreiben und pausiert immer für eine Freigabe. Der Vault muss
# existieren, sonst startet die Runtime nicht. Leer = keine notes.*-Tools.
OBSIDIAN_VAULT_PATH=
# Wo das Langzeitgedächtnis liegt (S18): Markdown-Notizen plus SQLite-Volltextindex, ein
# eigenes Git-Repo. Leer = ./memory neben dem Quelltext. Anders als OBSIDIAN_VAULT_PATH
# schaltet diese Variable nichts frei — memory.search/memory.write sind immer im Katalog,
# ein Assistent ohne Gedächtnis wäre die schlechtere Vorgabe. Fehlt der Ordner, wird er
# angelegt; ein leeres Gedächtnis beim ersten Start ist der Normalfall.
MEMORY_ROOT=
# Kommagetrennte Hosts, die web.fetch/web.search abrufen dürfen (Subdomains eingeschlossen).
# Leer = web.* ruft nichts ab (deny-by-default, S09).
WEB_EGRESS_ALLOWLIST=
# n8n-Brücke (S13). Von der Runtime aus erreichbare n8n-Instanz: im Compose-Netz
# http://n8n:5678, lokal http://localhost:5678. Leer = die n8n-Brücke ist registriert,
# aber nicht bedienbar. Ist der Wert gesetzt, kommen die Assistenz-Tools über n8n in den
# Katalog: mail.search/read/draft (S14), cal.list/create/update und server.metrics (S15).
# Die zugehörigen Workflows liegen unter tools/mail/workflows/, tools/cal/workflows/ und
# tools/server/workflows/. cal.create/cal.update sind hartes Schreiben und pausieren für
# eine Freigabe; ein mail.send gibt es nicht.
N8N_BASE_URL=
# Optionales gemeinsames Geheimnis, das die Brücke als Header x-kuronami-token mitschickt.
# Leer = kein Header; im abgeschotteten Compose-Netz trägt die Netzgrenze die Kontrolle.
N8N_WEBHOOK_TOKEN=
# Nur für docker-compose: Schlüssel, mit dem n8n Credentials in seiner DB verschlüsselt.
# Muss über Neustarts stabil bleiben, sonst sind gespeicherte Credentials nicht mehr lesbar.
N8N_ENCRYPTION_KEY=

# --- Gateway (S16) ---------------------------------------------------------
# Der Gateway-Prozess (`pnpm gateway`) ist die Außenwelt des Systems: er normalisiert
# Nachrichten, authentifiziert sie und führt sie in die Unterhaltung des Nutzers. Die
# Runtime authentifiziert nichts — sie sieht nur Sessions.
#
# Der eine Nutzer. Bestimmt den Faden der Unterhaltung (thread_user_<id>) und damit das
# Gedächtnis: alle Kanäle dieses Nutzers landen in derselben Session (Kanal `gateway`).
# Ein anderer Wert = eine andere Unterhaltung, also ein anderes Gedächtnis.
GATEWAY_USER_ID=
# Port des Gateway-HTTP-Rands. Vorgabe 8788 (die DevUI aus S12b hält 8787).
GATEWAY_PORT=
# Bearer-Token des Web-Kanals. Leer = der Web-Kanal nimmt nichts an. Wird auch von
# `pnpm say` gelesen, zusammen mit GATEWAY_URL (Vorgabe http://localhost:8788).
#
# Er ist seit 2026-09-20 zusätzlich der **Signierschlüssel der Anmeldesitzungen** (siehe
# WEB_LOGIN_USER): wer ihn wechselt, meldet damit jeden angemeldeten Browser ab. Das ist
# gewollt — ein abhandengekommener Zugang wird so mit einem Handgriff geschlossen.
GATEWAY_WEB_TOKEN=
GATEWAY_URL=
# Die Anmeldung der Oberfläche (2026-09-20). **Ein** Benutzer, kein Registrierungsweg: dieses
# Haus hat einen Nutzer, und ein zweiter Eingang wird von niemandem beobachtet. Bleiben beide
# Zeilen leer, verlangt die Oberfläche weiter den Betreiber-Token von Hand — dann steht sie
# jedem offen, der ihn kennt.
WEB_LOGIN_USER=
# Das Passwort **nur als Hash**: `pnpm passwort <klartext>` druckt ihn (scrypt mit eigenem
# Salz). Der Klartext steht damit weder in dieser Datei noch im Quelltext noch in der Historie.
WEB_LOGIN_HASH=
# Herkünfte jenseits von localhost, die der Browser-CORS-Check und der Event-Socket zulassen
# (runtime/events/bus.ts, originAllowed). Kommagetrennt, exakte Ursprünge inkl. Port. Leer =
# nur localhost, wie bisher. Nötig, sobald die Oberfläche über eine andere Adresse als
# localhost/127.0.0.1 aufgerufen wird (z. B. die öffentliche IP eines Servers).
EVENTS_ALLOWED_ORIGINS=
# Telegram (Kanal 2). Bot-Token von @BotFather; leer = der Kanal stellt nichts zu.
TELEGRAM_BOT_TOKEN=
# Erlaubte Telegram-Nutzerkennungen, kommagetrennt. Leer = der Kanal nimmt nichts an.
# Das ist die eigentliche Kontrolle: jeder Mensch kann einem Bot schreiben, und sein Update
# trägt dasselbe gültige Webhook-Geheimnis wie das des Betreibers.
TELEGRAM_ALLOWED_USER_IDS=
# Geheimnis im Header X-Telegram-Bot-Api-Secret-Token. Nur für den Webhook-Betrieb nötig;
# beim Long-Polling (Vorgabe) gibt es keinen Header.
TELEGRAM_WEBHOOK_SECRET=
# `webhook` schaltet das Long-Polling ab und erwartet Updates auf
# POST /channels/telegram/webhook. Alles andere (auch leer) = Long-Polling, das ohne
# öffentliche Adresse auskommt.
TELEGRAM_MODE=

# Slack (Kanal 3, S26). Bot-Token der Slack-App (OAuth & Permissions → Bot User OAuth Token,
# xoxb-...); leer = der Kanal stellt nichts zu.
SLACK_BOT_TOKEN=
# Signiergeheimnis der Slack-App (Basic Information → Signing Secret). Beweist, dass eine
# Zustellung wirklich von Slack kommt — nicht, von wem (siehe TELEGRAM_WEBHOOK_SECRET).
SLACK_SIGNING_SECRET=
# Erlaubte Slack-Nutzerkennungen, kommagetrennt. Leer = der Kanal nimmt nichts an — das ist
# die eigentliche Kontrolle (wie TELEGRAM_ALLOWED_USER_IDS).
SLACK_ALLOWED_USER_IDS=
# Events-API-Endpunkt: POST /channels/slack/events (Request-URL in der Slack-App-Konfiguration
# unter Event Subscriptions). Kein Long-Polling-Äquivalent — ohne öffentliche Adresse bleibt
# der Kanal unbedienbar, dieselbe Lage wie TELEGRAM_MODE=webhook ohne Tunnel.

# --- Heartbeat (S17) -----------------------------------------------------------
# Der Heartbeat-Prozess (`pnpm heartbeat`) ist proaktives Verhalten: er erzeugt nach
# Zeitplan den Morgen-Digest und reagiert auf gemeldete Ereignisse (POST /notify). Jeder
# Lauf ist ein Hintergrundlauf — Kanal `heartbeat`, Modus `background`, engere Tool-Whitelist
# und ein Regelsatz, der das Schreiben in die Quellzone (und damit ins Langzeitgedächtnis
# memory/) technisch zu `deny` macht. Braucht ANTHROPIC_API_KEY und, für Mail/Kalender/Server
# im Digest, N8N_BASE_URL.
#
# Cron-Ausdruck für den Morgen-Digest (m h dom mon dow, lokale Zeit). Vorgabe: 0 7 * * *.
HEARTBEAT_DIGEST_CRON=
# Höchstzahl Hintergrundläufe je Kalendertag (Digest + Meldungen zusammen). Vorgabe 8.
HEARTBEAT_MAX_RUNS_PER_DAY=
# Wie oft der Dienst prüft, ob der Digest fällig ist, in Sekunden. Vorgabe 30, Minimum 5.
HEARTBEAT_POLL_SECONDS=
# Port des HTTP-Rands (GET /health, POST /notify). Vorgabe 8789.
HEARTBEAT_PORT=
# Bearer-Token für POST /notify. Leer = der Endpunkt nimmt nichts an (nur Zeitplan). Ein
# n8n-Workflow für "neue Mail" oder ein Monitoring-Hook schickt ihn mit.
HEARTBEAT_NOTIFY_SECRET=
# Zustellkanal: `telegram` oder `console`. Leer = telegram, wenn TELEGRAM_BOT_TOKEN und ein
# Ziel gesetzt sind, sonst console (der Digest liegt in beiden Fällen als Artefakt).
HEARTBEAT_CHANNEL=
# Wohin der Digest geht. Bei Telegram die Chat-Kennung. Vorgabe: die erste aus
# TELEGRAM_ALLOWED_USER_IDS.
HEARTBEAT_DELIVER_TO=

# --- Sprachschicht (S30/S31) ---------------------------------------------------------
# Ein eigener Prozess, in Python, mit Pipecat (`voice/`). Abschnitt 4.1 nennt ihn die eine
# Ausnahme von "TypeScript auf Node": eine Prozessgrenze, kein zweiter Stack im Kern. Er
# läuft im Container (`docker compose --profile voice up voice`) und spricht mit der Runtime
# ausschließlich über den Sprach-Kanal des Gateways.
#
# `live` = Deepgram für die Erkennung, Azure oder ElevenLabs für die Stimme (`VOICE_TTS`);
# Pflicht sind nur die Schlüssel des gewählten Anbieters.
# `loopback` = dieselbe Pipeline mit lokalen Stand-ins, für Messung und Prüfung ohne Anbieter.
VOICE_MODE=
# Das gemeinsame Geheimnis des WebSocket-Randes. Der Client (Browser, Messstand) zeigt es als
# erste Nachricht vor; ohne diesen Wert **startet der Prozess nicht**. Ein offener Sprachport
# auf diesem Rechner wäre eine Fernbedienung für den Agenten.
VOICE_SESSION_TOKEN=
# Der Bearer-Token, mit dem die Brücke am Gateway auftritt (Kanal `voice`). Leer = der
# Sprach-Kanal ist im Gateway gar nicht erst eingerichtet, und der Prozess startet nicht.
# Bewusst **nicht** derselbe wie GATEWAY_WEB_TOKEN: zwei Prozesse, zwei Ausweise.
VOICE_BRIDGE_TOKEN=
# Wo der WebSocket-Rand lauscht. Vorgabe 127.0.0.1:8790 (im Container setzt compose 0.0.0.0).
VOICE_HOST=
VOICE_PORT=
# Erlaubte Browser-Ursprünge, kommagetrennt. Leer = keine Ursprungsprüfung (der Normalfall für
# den Messstand, der ohne Browser läuft).
VOICE_ALLOWED_ORIGINS=
# Wohin die Brücke spricht. Vorgabe http://127.0.0.1:8788, im Compose-Netz http://gateway:8788.
VOICE_GATEWAY_URL=
# Wie lange die Brücke auf einen Zug wartet, in Sekunden. Vorgabe 180 — ein Lauf mit Werkzeugen
# und Freigaben darf länger dauern als ein Modellaufruf.
VOICE_GATEWAY_TIMEOUT_SECS=

# Deepgram (Erkennung, nur bei VOICE_MODE=live).
DEEPGRAM_API_KEY=
# Leer = Deepgrams eigene Adresse. Gesetzt zeigt auf einen anderen Endpunkt — der Weg, dieselbe
# Messung gegen etwas anderes laufen zu lassen, ohne den Code zu ändern.
DEEPGRAM_BASE_URL=
# Vorgabe `multi` (mehrsprachig, seit 2026-09-21) — noetig, damit englische Fachbegriffe in
# deutschen Saetzen ankommen. Vorher stand hier `de`, und daraus wurde aus "Heartbeat" ein
# "Hardbeat". Zurueck zum alten Verhalten: DEEPGRAM_LANGUAGE=de und DEEPGRAM_MODEL=nova-2.
DEEPGRAM_LANGUAGE=
# Vorgabe `nova-3`. `multi` als Sprache gibt es nur mit diesem Modell.
DEEPGRAM_MODEL=
# Begriffe, die Deepgram bevorzugt erkennen soll, kommagetrennt. Leer = keine Vorgabe.
# **Nachgemessen am 2026-09-21** an einem Azure-gesprochenen Satz: `multi` nimmt das Feld an,
# und es entscheidet ueber genau die Woerter, an denen Jakob sich gestoert hat. Derselbe Ton,
# zwei Einstellungen:
#   nova-2/de ohne Keyterms: "Hardbeat", "Pepe Trading", "Stab, Laws", "Coronami"
#   nova-3/multi mit Keyterms: "Heartbeat", "Paper Trading", "Stop-Loss", "Kuronami"
# Eigennamen und Fachbegriffe gehoeren hier hinein, gebraeuchliche Woerter nicht.
DEEPGRAM_KEYTERMS=Open Interest,Funding Rate,Watchlist,Pullback,Breakout,Swing,Squeeze,Long,Short,Bitcoin,BTC,Ethereum,Rücksetzer,Prognose

# Wer die Stimme stellt: `azure` (Vorgabe seit 2026-09-21) oder `elevenlabs`.
#
# Der Wechsel ist eine Kostenrechnung, keine Geschmacksfrage: ElevenLabs bietet zwischen
# 121.000 Zeichen (11 $/Monat) und 600.000 Zeichen (99 $/Monat) nichts an, und ein einziges
# Gespraech vom 2026-09-21 verbrauchte 2.837 Zeichen. Azure nimmt 15 $ je Million Zeichen
# (Neural) bzw. 22 $ (HD) und gibt 500.000 Zeichen im Monat frei.
VOICE_TTS=

# Azure Speech (Stimme, bei VOICE_TTS=azure). Schluessel und Region stehen im Azure-Portal
# unter der Speech-Ressource → "Keys and Endpoint". Gebraucht wird der Kurzname aus dem
# Endpunkt — aus `https://germanywestcentral.api.cognitive.microsoft.com/` also
# `germanywestcentral`, nicht die Schreibweise der Portal-Anzeige ("Germany West Central").
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Vorgabe `de-DE-FlorianMultilingualNeural`: deutsche Männerstimme, die englische Fachbegriffe
# abschnittsweise englisch ausspricht (siehe `force_locale` in voice/pipeline/services.py).
# Alternativen mit hoeherer Qualitaet, 22 $ statt 15 $ je Million Zeichen:
#   de-DE-Florian:DragonHDLatestNeural   — HD, ruhig
#   de-DE-Klaus:MAI-Voice-2-Flash        — HD mit Sprechstilen, auf Echtzeit ausgelegt
# Ob eine HD-Stimme in der gewaehlten Region liegt, sagt die Stimmliste der Ressource
# (`GET https://<region>.tts.speech.microsoft.com/cognitiveservices/voices/list`). In
# `germanywestcentral` ist am 2026-09-21 **keine** deutsche HD-Stimme gelistet, wohl aber
# beide multilingualen Neural-Stimmen (Florian, Seraphina).
AZURE_SPEECH_VOICE=
# Die Sprache des Satzes drumherum. Vorgabe `de-DE`.
AZURE_SPEECH_LANGUAGE=

# ElevenLabs (Stimme, bei VOICE_TTS=elevenlabs). Ohne ELEVENLABS_VOICE_ID gibt es keine Stimme.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
ELEVENLABS_URL=

# Abtastraten. Deepgram hört mit 16 kHz, die Stimme spricht mit 24 kHz — die Vorgaben.
VOICE_AUDIO_IN_SAMPLE_RATE=
VOICE_AUDIO_OUT_SAMPLE_RATE=

# Sprachdetektor. `silero` (Vorgabe, Betrieb) oder `energy` (Messstand, siehe
# voice/pipeline/vad.py: Silero hält synthetischen Ton zu Recht für keine Stimme, und eine
# wiederholbare Messung braucht einen Reiz, den der Messende selbst erzeugt).
VOICE_VAD=
VOICE_VAD_CONFIDENCE=
# Wie lange Stimme anliegen muss, bevor sie als Anfang gilt — und Stille, bevor sie als Ende
# gilt. Beide gehen unmittelbar in die Barge-in-Zeit ein (S31).
VOICE_VAD_START_SECS=
VOICE_VAD_STOP_SECS=
VOICE_VAD_MIN_VOLUME=
VOICE_VAD_ENERGY_THRESHOLD=

# Die Obergrenze aus dem Fertig-Kriterium von S31, in Millisekunden. Vorgabe 800. Sie gilt für
# die Sprachschicht **ohne** die Denkzeit des Agenten — die Begründung steht in
# voice/pipeline/latency.py.
VOICE_LATENCY_BUDGET_MS=

# Nur im Loopback: was die Stand-in-Erkennung liefert und wie lang die Stand-in-Stimme spricht.
VOICE_LOOPBACK_TRANSCRIPT=
VOICE_LOOPBACK_SECS_PER_WORD=

# ---------------------------------------------------------------------------
# Postfächer (seit 2026-09-18 direkt über IMAP/SMTP, n8n ist dafür raus).
#
# Pro Konto ein Block, durchnummeriert ab 1. NAME ist der Name, unter dem Jakob es
# kennt und unter dem Kuro es anspricht. IMAP und SMTP haben Gmail-Vorgaben und
# müssen nur bei anderen Anbietern gesetzt werden.
#
# Gmail geht ueber eine Zustimmung im Browser, nicht ueber ein Passwort: App-Passwoerter
# sind fuer viele Konten gar nicht anwaehlbar ("die gesuchte Einstellung ist fuer Ihr Konto
# nicht verfuegbar"). Einmalig in der Google Cloud Console eine OAuth-Client-ID vom Typ
# Webanwendung anlegen, die Gmail-API aktivieren, und als Weiterleitungs-URI eintragen:
#   https://gateway.203-0-113-7.sslip.io/postfach/zurueck
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Danach je Konto /postfach/verbinden im Browser aufrufen; die Seite gibt diese Zeilen aus:
# MAIL_1_NAME=Privat
# MAIL_1_USER=name@gmail.com
# MAIL_1_GOOGLE=<die Erneuerung aus /postfach/verbinden>
#
# Anbieter, die einfaches IMAP noch zulassen, brauchen stattdessen nur ein Passwort:
# MAIL_2_PASS=...
# MAIL_2_IMAP=imap.example.org:993
# MAIL_2_SMTP=smtp.example.org:465

# ---------------------------------------------------------------------------
# Trading Journal in Notion (gateway/journal.ts, gateway/integrations/notion.ts).
#
# Ein eigener, sehr kleiner Client statt eines allgemeinen Notion-Servers: der Gateway soll
# eine Zeile schreiben, eine Zeile ändern und lesen können — nichts weiter. Ein allgemeiner
# Server brächte dreißig Werkzeugschemata mit, die in jedem Modellaufruf mitbezahlt werden,
# und Schreibrechte in jeder Ecke des Arbeitsbereichs.
#
# Der Zugang ist ein Integrationstoken. Einmalig:
#   1. notion.so/my-integrations → neue interne Integration anlegen, Geheimnis kopieren
#   2. In Notion die Seite „Trading Journal" öffnen → „…" → Verbindungen → die Integration
#      hinzufügen. Ohne diese Freigabe sieht die Integration nichts, und jeder Abruf endet
#      in einem 404 — das Werkzeug sagt dann genau das, statt ein leeres Journal zu melden.
NOTION_TOKEN=
#
# Die Kennungen aus Jakobs Arbeitsbereich stehen als Vorgabe im Code (JOURNAL_IDS in
# gateway/journal.ts) und müssen nur gesetzt werden, wenn er umzieht oder eine Datenbank neu
# anlegt. Geprüft am 2026-09-21 gegen die Seite „Trading Journal".
# NOTION_TRADES_DB=
# NOTION_LEKTIONEN_DB=
# NOTION_REGELN_PAGE=
# NOTION_SETUPS_PAGE=
# NOTION_WATCHLIST_DB=
#
# Wie lange der Butler auf den Journalführer wartet, bevor er zusagt und nachreicht.
# KURO_GEDULD_JOURNAL_MS=
