      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Eingabe der Runtime: { to, subject, body, cc?, in_reply_to?, account? }\nconst incoming = $input.first().json;\nconst inp = incoming.body && typeof incoming.body === 'object' ? incoming.body : incoming;\nif (typeof inp.to !== 'string' || inp.to.trim() === '') throw new Error('mail-draft: Feld \"to\" fehlt');\nif (typeof inp.body !== 'string' || inp.body.trim() === '') throw new Error('mail-draft: Feld \"body\" fehlt');\nconst knownAccounts = ['gmail_1', 'gmail_2', 'gmail_3', 'outlook_1', 'outlook_2'];\nconst account = knownAccounts.includes(inp.account) ? inp.account : 'gmail_1';\nreturn [{ json: {\n  to: inp.to.trim(),\n  cc: typeof inp.cc === 'string' ? inp.cc.trim() : '',\n  subject: typeof inp.subject === 'string' ? inp.subject : '',\n  message: inp.body,\n  in_reply_to: typeof inp.in_reply_to === 'string' ? inp.in_reply_to.trim() : '',\n  account\n} }];"
      },
