      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Eingabe der Runtime: { id: string } - id kommt aus mail.search, mit Konto-Praefix.\nconst incoming = $input.first().json;\nconst inp = incoming.body && typeof incoming.body === 'object' ? incoming.body : incoming;\nif (typeof inp.id !== 'string' || inp.id.trim() === '') {\n  throw new Error('mail-read: Feld \"id\" fehlt');\n}\nconst raw = inp.id.trim();\nconst knownAccounts = ['gmail_1', 'gmail_2', 'gmail_3', 'outlook_1', 'outlook_2'];\nconst sepIndex = raw.indexOf(':');\nconst prefix = sepIndex >= 0 ? raw.slice(0, sepIndex) : '';\nconst account = knownAccounts.includes(prefix) ? prefix : 'gmail_1';\nconst messageId = knownAccounts.includes(prefix) ? raw.slice(sepIndex + 1) : raw;\nreturn [{ json: { messageId, account } }];"
      },
