      "id": "r0300-0000-4a00-8000-000000000300",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [1120, 340],
      "notes": "Genau ein Zweig liefert je Aufruf ein Ergebnis (Filter oben) — append haengt es an."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// In die von der Runtime erwartete Form bringen. Anhaenge als base64 - dasselbe\n// Binaerformat bei beiden Anbietern (attachmentsPrefix), daher unveraendert uebernehmbar.\nconst item = $input.first();\nconst m = item.json || {};\nconst bin = item.binary || {};\nconst attachments = Object.keys(bin).map((key) => {\n  const b = bin[key];\n  return {\n    filename: b.fileName || key,\n    mime_type: b.mimeType || 'application/octet-stream',\n    content_base64: b.data || ''\n  };\n});\nconst isOutlook = m.body && typeof m.body === 'object' && typeof m.body.content === 'string';\nif (isOutlook) {\n  const fromAddr = (m.from && m.from.emailAddress) || {};\n  const toAddrs = Array.isArray(m.toRecipients)\n    ? m.toRecipients.map((r) => (r.emailAddress && r.emailAddress.address) || '').filter(Boolean).join(', ')\n    : '';\n  const isHtml = (m.body.contentType || '').toLowerCase() === 'html';\n  return [{ json: {\n    id: String(m.id || ''),\n    subject: m.subject || '',\n    from: fromAddr.name ? (fromAddr.name + ' <' + fromAddr.address + '>') : (fromAddr.address || ''),\n    to: toAddrs,\n    date: m.receivedDateTime || '',\n    body_text: isHtml ? '' : String(m.body.content || ''),\n    body_html: isHtml ? String(m.body.content || '') : '',\n    body_mime: isHtml ? 'text/html' : 'text/plain',\n    attachments\n  } }];\n}\nconst payloadHeaders = (m.payload && m.payload.headers) || [];\nconst h = (name) => {\n  const hit = payloadHeaders.find((x) => (x.name || '').toLowerCase() === name);\n  return hit ? hit.value : '';\n};\n// Gmails RAW-Format (simple:false) liefert from/to schon als geparstes Objekt\n// ({ value, html, text }), nicht als blossen Header-String - .text ist die lesbare Form\n// (gefunden 2026-09-16 beim ersten echten Testlauf, vorher stand dort das rohe Objekt).\nconst addrText = (value) => {\n  if (typeof value === 'string') return value;\n  if (value && typeof value.text === 'string') return value.text;\n  return '';\n};\nreturn [{ json: {\n  id: String(m.id || m.messageId || ''),\n  subject: m.subject || h('subject') || '',\n  from: addrText(m.from) || h('from') || '',\n  to: addrText(m.to) || h('to') || '',\n  date: m.date || h('date') || m.internalDate || '',\n  body_text: (m.text != null ? String(m.text) : ''),\n  body_html: (m.textHtml != null ? String(m.textHtml) : (m.html != null ? String(m.html) : '')),\n  body_mime: (m.text != null ? 'text/plain' : 'text/html'),\n  attachments\n} }];"
      },
